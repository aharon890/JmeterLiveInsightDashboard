<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Spike Load Test — 30min with Idle Period">
      <stringProp name="TestPlan.comments">30-minute spike test with Open Model Thread Group. Simulates realistic spike patterns with a 5-minute idle period in the middle (minutes 12-17).</stringProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments">
        <collectionProp name="Arguments.arguments">
          <elementProp name="BASE_DELAY" elementType="Argument">
            <stringProp name="Argument.name">BASE_DELAY</stringProp>
            <stringProp name="Argument.value">50</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
    </TestPlan>
    <hashTree>

      <!-- Open Model Thread Group: Spike Profile with 5-min Idle -->
      <org.apache.jmeter.threads.openmodel.OpenModelThreadGroup guiclass="org.apache.jmeter.threads.openmodel.OpenModelThreadGroupGui" testclass="org.apache.jmeter.threads.openmodel.OpenModelThreadGroup" testname="Spike Traffic — E-Commerce API" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <intProp name="LoopController.loops">1</intProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
        <stringProp name="OpenModelThreadGroup.schedule">rate(0/sec) random_arrivals(180 sec) rate(5/sec) random_arrivals(60 sec) rate(5/sec) random_arrivals(60 sec) rate(15/sec) random_arrivals(30 sec) rate(15/sec) random_arrivals(30 sec) rate(3/sec) random_arrivals(60 sec) rate(3/sec) random_arrivals(60 sec) rate(20/sec) random_arrivals(30 sec) rate(20/sec) random_arrivals(30 sec) rate(8/sec) random_arrivals(60 sec) rate(8/sec) random_arrivals(60 sec) rate(25/sec) random_arrivals(30 sec) rate(25/sec) random_arrivals(30 sec) rate(0/sec) random_arrivals(300 sec) rate(0/sec) random_arrivals(60 sec) rate(5/sec) random_arrivals(60 sec) rate(5/sec) random_arrivals(60 sec) rate(18/sec) random_arrivals(30 sec) rate(18/sec) random_arrivals(30 sec) rate(5/sec) random_arrivals(60 sec) rate(5/sec) random_arrivals(30 sec) rate(30/sec) random_arrivals(30 sec) rate(30/sec) random_arrivals(30 sec) rate(10/sec) random_arrivals(30 sec) rate(10/sec) random_arrivals(30 sec) rate(0/sec)</stringProp>
      </org.apache.jmeter.threads.openmodel.OpenModelThreadGroup>
      <hashTree>

        <!-- Sampler 1: Browse Products (fast, low error) -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="GET /api/v2/marketplace/homepage/featured-products?category=electronics&amp;sortBy=popularity&amp;limit=24&amp;includeReviews=true" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom

def random = ThreadLocalRandom.current()
def delay = random.nextInt(80, 250)
Thread.sleep(delay)

// 1% error rate
if (random.nextInt(100) &lt; 1) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;500&quot;)
    SampleResult.setResponseMessage(&quot;Internal Server Error&quot;)
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;Homepage service temporarily unavailable&quot;}&apos;, &quot;UTF-8&quot;)
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;200&quot;)
    SampleResult.setResponseMessage(&quot;OK&quot;)
    SampleResult.setResponseData(&apos;{&quot;page&quot;:&quot;home&quot;,&quot;featured_products&quot;:12,&quot;banners&quot;:3}&apos;, &quot;UTF-8&quot;)
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(128)
          </stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree/>

        <!-- Sampler 2: Search (variable, spiky latency) -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="GET /api/v2/marketplace/sellers/{sellerId}/products/search?status=active&amp;minRating=4.5&amp;verified=true" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom

def random = ThreadLocalRandom.current()
def queries = [&quot;laptop&quot;, &quot;phone&quot;, &quot;headphones&quot;, &quot;monitor&quot;, &quot;keyboard&quot;]
def query = queries[random.nextInt(queries.size())]

def delay = random.nextInt(150, 600)
if (random.nextInt(100) &lt; 10) { delay += random.nextInt(200, 500) }
Thread.sleep(delay)

if (random.nextInt(100) &lt; 5) {
    SampleResult.setSuccessful(false)
    if (random.nextBoolean()) {
        SampleResult.setResponseCode(&quot;504&quot;)
        SampleResult.setResponseMessage(&quot;Gateway Timeout&quot;)
        SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;Search service timeout&quot;}&apos;, &quot;UTF-8&quot;)
    } else {
        SampleResult.setResponseCode(&quot;503&quot;)
        SampleResult.setResponseMessage(&quot;Service Unavailable&quot;)
        SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;Search index rebuilding&quot;}&apos;, &quot;UTF-8&quot;)
    }
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;200&quot;)
    SampleResult.setResponseMessage(&quot;OK&quot;)
    SampleResult.setResponseData(&apos;{&quot;query&quot;:&quot;&apos; + query + &apos;&quot;,&quot;results&quot;:&apos; + random.nextInt(0, 150) + &apos;}&apos;, &quot;UTF-8&quot;)
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(96)
          </stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree/>

        <!-- Sampler 3: Product Detail (medium) -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="GET /api/v2/catalog/products/{productId}/variants?includeInventory=true&amp;warehouse=US-WEST-2&amp;currency=USD" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom

def random = ThreadLocalRandom.current()
def delay = random.nextInt(50, 300)
Thread.sleep(delay)

if (random.nextInt(100) &lt; 2) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;404&quot;)
    SampleResult.setResponseMessage(&quot;Not Found&quot;)
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;Product not found&quot;}&apos;, &quot;UTF-8&quot;)
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;200&quot;)
    SampleResult.setResponseMessage(&quot;OK&quot;)
    SampleResult.setResponseData(&apos;{&quot;id&quot;:123,&quot;name&quot;:&quot;Widget Pro&quot;,&quot;price&quot;:29.99}&apos;, &quot;UTF-8&quot;)
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(64)
          </stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree/>

        <!-- Sampler 4: Add to Cart (slower) -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="POST /api/v2/shopping-cart/{cartId}/items/add?applyPromotions=true&amp;loyaltyProgram=GOLD" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom

def random = ThreadLocalRandom.current()
def delay = random.nextInt(100, 400)
Thread.sleep(delay)

if (random.nextInt(100) &lt; 3) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;409&quot;)
    SampleResult.setResponseMessage(&quot;Conflict&quot;)
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;Item out of stock&quot;}&apos;, &quot;UTF-8&quot;)
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;200&quot;)
    SampleResult.setResponseMessage(&quot;OK&quot;)
    SampleResult.setResponseData(&apos;{&quot;cartId&quot;:&quot;cart-001&quot;,&quot;items&quot;:3,&quot;total&quot;:89.97}&apos;, &quot;UTF-8&quot;)
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(192)
          </stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree/>

        <!-- Sampler 5: Checkout (slowest, highest error) -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="POST /api/v2/orders/checkout/process-payment?provider=stripe&amp;method=card&amp;3dsecure=required" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom

def random = ThreadLocalRandom.current()
def delay = random.nextInt(300, 800)
if (random.nextInt(100) &lt; 15) { delay += random.nextInt(300, 600) }
Thread.sleep(delay)

def roll = random.nextInt(100)
if (roll &lt; 4) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;402&quot;)
    SampleResult.setResponseMessage(&quot;Payment Required&quot;)
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;Payment declined&quot;}&apos;, &quot;UTF-8&quot;)
} else if (roll &lt; 8) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;500&quot;)
    SampleResult.setResponseMessage(&quot;Internal Server Error&quot;)
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;Payment gateway timeout&quot;}&apos;, &quot;UTF-8&quot;)
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;201&quot;)
    SampleResult.setResponseMessage(&quot;Created&quot;)
    SampleResult.setResponseData(&apos;{&quot;orderId&quot;:&quot;ORD-123&quot;,&quot;status&quot;:&quot;confirmed&quot;}&apos;, &quot;UTF-8&quot;)
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(512)
          </stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree/>

        <!-- Sampler 6: User Profile (fastest) -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="POST /api/v2/identity/oauth2/token?grant_type=authorization_code&amp;redirect_uri=https://app.example.com/callback" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom

def random = ThreadLocalRandom.current()
def delay = random.nextInt(200, 500)
Thread.sleep(delay)

if (random.nextInt(100) &lt; 3) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;401&quot;)
    SampleResult.setResponseMessage(&quot;Unauthorized&quot;)
    SampleResult.setResponseData(&apos;{&quot;error&quot;:&quot;Invalid credentials&quot;}&apos;, &quot;UTF-8&quot;)
} else {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode(&quot;200&quot;)
    SampleResult.setResponseMessage(&quot;OK&quot;)
    SampleResult.setResponseData(&apos;{&quot;token&quot;:&quot;eyJhbGciOiJIUzI1NiJ9.mock&quot;,&quot;expiresIn&quot;:3600}&apos;, &quot;UTF-8&quot;)
}
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(256)
          </stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree/>

      </hashTree>

      <!-- Live Insight Dashboard Listener -->
