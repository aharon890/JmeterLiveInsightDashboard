          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="TX step 1 - add to cart" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom

// A step of a transaction that generates a parent sample: it reaches listeners as a sub-result.
Thread.sleep(ThreadLocalRandom.current().nextInt(40, 160))
SampleResult.setSuccessful(true)
SampleResult.setResponseCode(&quot;200&quot;)
SampleResult.setResponseMessage(&quot;OK&quot;)
SampleResult.setResponseData(&quot;ok&quot;, &quot;UTF-8&quot;)
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(64)
            </stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
          </JSR223Sampler>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="TX step 2 - pay" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom

Thread.sleep(ThreadLocalRandom.current().nextInt(60, 200))
// Every third iteration is declined. The sampler itself succeeds and the
// &quot;Payment accepted&quot; assertion fails it, so every run has assertion failures
// (code 200) and failed transaction parents, not just by chance.
SampleResult.setSuccessful(true)
SampleResult.setResponseCode(&quot;200&quot;)
SampleResult.setResponseMessage(&quot;OK&quot;)
SampleResult.setResponseData(vars.getIteration() % 3 == 0 ? &quot;DECLINED&quot; : &quot;PAID&quot;, &quot;UTF-8&quot;)
SampleResult.setDataType(org.apache.jmeter.samplers.SampleResult.TEXT)
SampleResult.setSentBytes(64)
            </stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
          </JSR223Sampler>
          <hashTree>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Payment accepted" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="2448076">PAID</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message"></stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">16</intProp>
            </ResponseAssertion>
            <hashTree/>
          </hashTree>
        </hashTree>
