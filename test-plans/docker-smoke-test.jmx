<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Docker Smoke Test — E-Commerce API Simulation">
      <stringProp name="TestPlan.comments">Docker smoke plan for the Live Insight Dashboard: hermetic JSR223 load, listener config left empty so -J flags govern (bind/open-browser/port). Uses JSR223 Samplers to simulate API calls with varied response times and error rates. The third thread group feeds what the Docker gate checks against JMeter: transactions with and without a parent sample, an assertion failure, a sampler the default hide patterns hide, and labels with quotes, markup, backslashes and a comma.</stringProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments">
        <collectionProp name="Arguments.arguments">
          <elementProp name="BASE_DELAY" elementType="Argument">
            <stringProp name="Argument.name">BASE_DELAY</stringProp>
            <stringProp name="Argument.value">50</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
    </TestPlan>
