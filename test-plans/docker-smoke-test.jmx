        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Search &quot;quoted&quot; &lt;b&gt;bold&lt;/b&gt; &amp; co" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.concurrent.ThreadLocalRandom

// Quotes, markup and an ampersand in the label: it must reach the dashboard unchanged.
