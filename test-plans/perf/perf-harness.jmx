<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Perf Harness">
      <stringProp name="TestPlan.comments">Load and duration harness for the Live Insight Dashboard (scripts/perf). Hermetic JSR223 load; every knob is a -J property: threads, ramp, duration, rate, labels, rt_base_ms, rt_sigma, error_pct, error_kinds, resp_bytes, burst_period_ms, tx_threads, tx_think_ms, perf.dir. The Groovy files live next to this plan.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
    </TestPlan>
    <hashTree>
      <com.jmeterinsight.livedashboard.plugin.LiveDashboardListener guiclass="com.jmeterinsight.livedashboard.plugin.LiveDashboardListenerGui" testclass="com.jmeterinsight.livedashboard.plugin.LiveDashboardListener" testname="Live Insight Dashboard">
        <boolProp name="ResultCollector.error_logging">false</boolProp>
        <objProp>
          <name>saveConfig</name>
          <value class="SampleSaveConfiguration">
            <time>true</time>
            <latency>true</latency>
            <timestamp>true</timestamp>
            <success>true</success>
            <label>true</label>
            <code>true</code>
            <message>true</message>
            <threadName>true</threadName>
            <dataType>true</dataType>
            <encoding>false</encoding>
            <assertions>true</assertions>
            <subresults>true</subresults>
            <responseData>false</responseData>
            <samplerData>false</samplerData>
            <xml>false</xml>
            <fieldNames>true</fieldNames>
            <responseHeaders>false</responseHeaders>
            <requestHeaders>false</requestHeaders>
            <responseDataOnError>false</responseDataOnError>
            <saveAssertionResultsFailureMessage>true</saveAssertionResultsFailureMessage>
            <assertionsResultsToSave>0</assertionsResultsToSave>
            <bytes>true</bytes>
            <sentBytes>true</sentBytes>
            <url>true</url>
            <threadCounts>true</threadCounts>
            <idleTime>true</idleTime>
            <connectTime>true</connectTime>
          </value>
        </objProp>
        <stringProp name="live.dashboard.port"></stringProp>
        <stringProp name="live.dashboard.bind"></stringProp>
        <stringProp name="live.dashboard.open.browser"></stringProp>
        <stringProp name="live.dashboard.update.interval">2</stringProp>
        <stringProp name="live.dashboard.window.max">3600</stringProp>
        <stringProp name="live.dashboard.hide.patterns"></stringProp>
        <stringProp name="live.dashboard.sla.default.p95"></stringProp>
        <stringProp name="live.dashboard.sla.default.errorRate"></stringProp>
      </com.jmeterinsight.livedashboard.plugin.LiveDashboardListener>
      <hashTree/>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="load">
        <stringProp name="ThreadGroup.num_threads">${__P(threads,50)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(ramp,10)}</stringProp>
        <stringProp name="ThreadGroup.duration">${__P(duration,600)}</stringProp>
        <stringProp name="ThreadGroup.delay">0</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <stringProp name="LoopController.loops">-1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Timer guiclass="TestBeanGUI" testclass="JSR223Timer" testname="pacing">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="filename">${__P(perf.dir,/test/perf)}/perf-pacing.groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
        </JSR223Timer>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="request">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="filename">${__P(perf.dir,/test/perf)}/perf-sample.groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="transactions">
        <stringProp name="ThreadGroup.num_threads">${__P(tx_threads,0)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(ramp,10)}</stringProp>
        <stringProp name="ThreadGroup.duration">${__P(duration,600)}</stringProp>
        <stringProp name="ThreadGroup.delay">0</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <stringProp name="LoopController.loops">-1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="think">
          <stringProp name="ConstantTimer.delay">${__P(tx_think_ms,200)}</stringProp>
        </ConstantTimer>
        <hashTree/>
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="tx-checkout">
          <boolProp name="TransactionController.parent">true</boolProp>
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="tx-step-1">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="filename">${__P(perf.dir,/test/perf)}/perf-sample.groovy</stringProp>
            <stringProp name="parameters">tx-step-1</stringProp>
            <stringProp name="script"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
          </JSR223Sampler>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="tx-step-2">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="filename">${__P(perf.dir,/test/perf)}/perf-sample.groovy</stringProp>
            <stringProp name="parameters">tx-step-2</stringProp>
            <stringProp name="script"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
          </JSR223Sampler>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="tx-step-3">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="filename">${__P(perf.dir,/test/perf)}/perf-sample.groovy</stringProp>
            <stringProp name="parameters">tx-step-3</stringProp>
            <stringProp name="script"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
          </JSR223Sampler>
          <hashTree/>
        </hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
