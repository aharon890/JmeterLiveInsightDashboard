      <OpenModelThreadGroup guiclass="OpenModelThreadGroupGui" testclass="OpenModelThreadGroup" testname="OMTG Browse &amp; Search Users">
        <stringProp name="OpenModelThreadGroup.schedule">rate(0/sec) random_arrivals(120 sec) rate(3/sec) random_arrivals(60 sec) rate(3/sec) random_arrivals(60 sec) rate(10/sec) random_arrivals(30 sec) rate(10/sec) random_arrivals(30 sec) rate(2/sec) random_arrivals(60 sec) rate(2/sec) random_arrivals(60 sec) rate(15/sec) random_arrivals(30 sec) rate(15/sec) random_arrivals(30 sec) rate(5/sec) random_arrivals(60 sec) rate(5/sec) random_arrivals(60 sec) rate(20/sec) random_arrivals(30 sec) rate(20/sec) random_arrivals(30 sec) rate(0/sec) random_arrivals(300 sec) rate(0/sec) random_arrivals(60 sec) rate(3/sec) random_arrivals(60 sec) rate(3/sec) random_arrivals(60 sec) rate(12/sec) random_arrivals(30 sec) rate(12/sec) random_arrivals(30 sec) rate(3/sec) random_arrivals(60 sec) rate(3/sec) random_arrivals(30 sec) rate(25/sec) random_arrivals(30 sec) rate(25/sec) random_arrivals(30 sec) rate(8/sec) random_arrivals(30 sec) rate(8/sec) random_arrivals(30 sec) rate(0/sec)</stringProp>
