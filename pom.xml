<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.jmeterinsight</groupId>
    <artifactId>jmeter-live-dashboard</artifactId>
    <version>1.6.2</version>
    <packaging>jar</packaging>

    <name>JMeter Live Insight Dashboard</name>
    <description>Real-time browser-based live dashboard for JMeter test execution monitoring</description>
    <url>https://github.com/aharon890/JmeterLiveInsightDashboard</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/aharon890/JmeterLiveInsightDashboard</url>
        <connection>scm:git:https://github.com/aharon890/JmeterLiveInsightDashboard.git</connection>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jmeter.version>5.6.3</jmeter.version>
        <jackson.version>2.18.12</jackson.version>
        <slf4j.version>1.7.36</slf4j.version>
    </properties>

    <!-- Keeps jackson-core and jackson-annotations on jackson.version too. Without it
         they arrive through JMeter's own dependencies at 2.16.1, and that mix of Jackson
         versions on the compile and test classpath is not supported. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- JMeter Core (provided at runtime by JMeter) -->
        <dependency>
            <groupId>org.apache.jmeter</groupId>
            <artifactId>ApacheJMeter_core</artifactId>
            <version>${jmeter.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.jmeter</groupId>
            <artifactId>ApacheJMeter_components</artifactId>
            <version>${jmeter.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jackson JSON (provided by JMeter at runtime). Built against a patched
             release to clear the jackson-databind advisories, which JMeter 5.6.3's
             2.16.1 still carries; in JMeter that 2.16.1 is what loads. The plugin only
             writes JSON (ObjectMapper.writeValueAsString, JsonGenerator), and every
             advisory is on the reading side. A bump can still make javac bind a call to
             a method 2.16.1 lacks, so after one, build once more with
             -Djackson.version=2.16.1 and check the classes come out byte-identical. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- SLF4J (provided by JMeter at runtime) -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Apache-2.0 asks for LICENSE and NOTICE with every redistribution, and
                 the jar is one: it also carries the bundled ECharts. -->
            <resource>
                <directory>${project.basedir}</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>LICENSE</include>
                    <include>NOTICE</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <!-- release, not source/target: with source/target alone a newer JDK
                     compiles calls to APIs Java 11 doesn't have, and the jar then
                     fails at runtime on a Java 11 JMeter. release checks them. -->
                <configuration>
                    <release>11</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <!-- Nothing is bundled any more: t-digest was, until exact
                             percentiles replaced it, and everything else is provided
                             by JMeter. The step stays so a dependency added later is
                             packaged the same way; assert_jar_sane (scripts/lib/common.sh)
                             fails the build tiers if anything foreign lands in the jar. -->
                        <configuration>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <!-- Implementation-Version: what DashboardServer.PLUGIN_VERSION reads,
                             so the start log and /api/status name the build that is running. -->
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                        <manifestEntries>
                            <Built-By>JMeter Live Insight Dashboard</Built-By>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
