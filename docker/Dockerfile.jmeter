# The Java JMeter runs on. scripts/test-release.sh builds it once on 11, the oldest
# Java the plugin supports (pom.xml <release>11), as the jar's own runtime check.
ARG JAVA_IMAGE=eclipse-temurin:17-jre
FROM ${JAVA_IMAGE}

ENV JMETER_VERSION=5.6.3
ENV JMETER_HOME=/opt/apache-jmeter-${JMETER_VERSION}
ENV PATH=${JMETER_HOME}/bin:${PATH}

RUN apt-get update && apt-get install -y --no-install-recommends wget unzip \
    && wget -q https://archive.apache.org/dist/jmeter/binaries/apache-jmeter-${JMETER_VERSION}.tgz \
    && tar -xzf apache-jmeter-${JMETER_VERSION}.tgz -C /opt/ \
    && rm apache-jmeter-${JMETER_VERSION}.tgz \
    && apt-get purge -y wget \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /test

ENTRYPOINT ["jmeter"]
